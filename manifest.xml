<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>9f51b91c-99d7-4cf4-9789-3e15b771e3a5</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>FESJI</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="FESJI Document Linter" />
  <Description DefaultValue="Checks Word documents for deterministic university and student organization formatting issues." />
  <SupportUrl DefaultValue="https://127.0.0.1:5173/" />
  <AppDomains>
    <AppDomain>https://127.0.0.1:5173</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://127.0.0.1:5173/" />
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
</OfficeApp>
